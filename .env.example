AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Gemini (opcional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AI Proxy (opcional - dev guard, no es un secreto ni frontera de seguridad para clientes web)
# Las protecciones reales son la validación de Origin y el enlace exclusivo a localhost.
# AI_PROXY_TOKEN=optional_dev_guard_token
# VITE_AI_PROXY_TOKEN=optional_dev_guard_token

# Notion MCP: fixed browser origin for OAuth callbacks. Keep the same port as your notebook.
# NOTION_APP_ORIGIN=http://localhost:5181
# Optional encrypted local vault directory (default: .notion-local/, excluded from Git).
# NOTION_STORAGE_DIR=/absolute/private/path/conscious-notion

# Google Calendar OAuth (server only; never prefix these with VITE_)
# Register a Web application in Google Cloud and enable Google Calendar API.
# Authorized redirect URI: http://localhost:5181/api/google-calendar/callback
# GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
# GOOGLE_CALENDAR_APP_ORIGIN=http://localhost:5181
# GOOGLE_CALENDAR_STORAGE_DIR=/absolute/private/path/conscious-google-calendar
