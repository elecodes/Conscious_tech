{
  "name": "conscious-tech",
  "version": "0.20.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval-cases.ts",
    "eval:items": "tsx scripts/eval-cases.ts --skill=extract_items",
    "eval:relationships": "tsx scripts/eval-cases.ts --skill=detect_relationships",
    "eval:groups": "tsx scripts/eval-cases.ts --skill=group_work",
    "eval:deadlines": "tsx scripts/eval-cases.ts --skill=detect_deadlines",
    "eval:context": "tsx scripts/eval-cases.ts --skill=evaluate_context",
    "eval:week": "tsx scripts/eval-cases.ts --skill=build_week --provider=mock"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "groq-sdk": "^1.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
